# 이 파일을 복사해 .env 를 만들고 값을 채워 넣으세요. (.env 는 커밋되지 않습니다)

# ===== 백엔드 (Spring Boot) =====
# 서울 열린데이터광장 일반 인증키
SEOUL_OPEN_API_KEY=
# 공공데이터포털 개인 인증키 (소상공인 상가(상권)정보 API)
DATA_GO_KR_SERVICE_KEY=
# 카카오 REST API 키, 클라이언트 시크릿 (카카오 로그인)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 데이터베이스
DB_URL=jdbc:postgresql://localhost:5433/seoul_startup_sim
DB_USERNAME=
DB_PASSWORD=

# ===== 프론트엔드 (frontend/.env.local 에 따로 작성) =====
# 카카오 JavaScript 키 (등록된 도메인에서만 동작)
# VITE_KAKAO_JS_KEY=

DB_PORT=5433
SERVER_PORT=8081
